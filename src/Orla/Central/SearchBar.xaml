<UserControl x:Class="Orla.SearchBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Orla"
             FontFamily="{StaticResource Font.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
             Width="600" VerticalAlignment="Top">
    <!-- The search bar on the desktop: the same glass as the panels, a field, and the best matches from every panel
         below it while it has the focus. -->
    <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Brush.PanelGlass}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" Padding="8,4,8,4" Cursor="IBeam">
        <StackPanel>
            <DockPanel Height="40" Margin="8,0,6,0">
                <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Search}" Width="20" Margin="0,0,12,0"
                      VerticalAlignment="Center" Stroke="{DynamicResource Brush.Accent}" />
                <!-- While the bar is idle, the shortcut that brings it forward over any window. -->
                <Border x:Name="Hint" DockPanel.Dock="Right" CornerRadius="6" Padding="8,2" VerticalAlignment="Center"
                        Background="{DynamicResource Brush.ItemHover}">
                    <TextBlock x:Name="HintText" FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <Grid>
                    <TextBlock x:Name="Placeholder" Text="{l:T search.placeholder}" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource Brush.TextSecondary}" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" FontSize="16" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource Brush.Text}" CaretBrush="{DynamicResource Brush.Accent}"
                             SelectionBrush="{DynamicResource Brush.Accent}" VerticalContentAlignment="Center"
                             AutomationProperties.Name="{l:T search.placeholder}" />
                </Grid>
            </DockPanel>
            <StackPanel x:Name="Drop" Visibility="Collapsed" Cursor="Arrow">
                <!-- The shoreline under the field, as under every panel's title. -->
                <Path Height="6" Margin="10,0,10,6" Stretch="Fill" StrokeThickness="1.5" Stroke="{DynamicResource Brush.Accent}"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 0 3 C 40 0 70 6 110 3 S 190 0 230 3 S 280 6 300 3" />
                <StackPanel x:Name="Results" />
                <TextBlock x:Name="Nothing" Margin="10,6,10,8" Visibility="Collapsed" FontSize="{StaticResource Type.Body}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{l:T search.keys}" Margin="10,8,10,6" FontSize="{StaticResource Type.Caption}"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
