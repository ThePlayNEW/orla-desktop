<Window x:Class="Orla.CentralWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Orla"
        Title="Orla Desktop" Width="980" Height="680" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.Text}" FontSize="{StaticResource Type.Body}"
        Foreground="{DynamicResource Brush.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <!-- Orla draws its own title bar; Windows keeps the shadow, resizing and snapping. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="32" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Navigation entry with the Windows 11 selection pill. -->
        <Style x:Key="Orla.Nav" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Orla.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="12,8">
                            <Grid>
                                <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" Background="{DynamicResource Brush.Accent}"
                                        HorizontalAlignment="Left" Margin="-12,0,0,0" Visibility="Hidden" />
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Orla.Glyph}" Data="{TemplateBinding Tag}" Margin="0,0,12,0" />
                                    <ContentPresenter VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ItemHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Brush.ItemSelected}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A settings row, like the cards in Windows Settings. -->
        <Style x:Key="Orla.Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Groups cards on a long page, like the section names in Windows Settings. -->
        <Style x:Key="Orla.SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,20,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="Orla.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <Style x:Key="Orla.CardHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        </Style>

        <Style x:Key="Orla.PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Font.Display}" />
            <Setter Property="FontSize" Value="{StaticResource Type.Title}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        </Style>

        <!-- The sample wallpaper behind previews: sea above, sand below, the brand's shoreline. -->
        <LinearGradientBrush x:Key="Orla.Shore" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#2F6F78" />
            <GradientStop Offset="0.62" Color="#8FC3C6" />
            <GradientStop Offset="0.63" Color="#E4D6BC" />
            <GradientStop Offset="1" Color="#D8C7A6" />
        </LinearGradientBrush>

        <!-- Preset card on the welcome screen. -->
        <Style x:Key="Orla.PresetCard" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Orla.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,12" MinHeight="96">
                            <Grid>
                                <Border x:Name="Tick" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <Path x:Name="Mark" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Check}" Width="20" Height="20"
                                          Stroke="{DynamicResource Brush.OnAccent}" Margin="-2" Visibility="Hidden">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0.8" ScaleY="0.8" CenterX="10" CenterY="10" />
                                        </Path.RenderTransform>
                                    </Path>
                                </Border>
                                <ContentPresenter Margin="0,0,24,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Tick" Property="Background" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Tick" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A metric on the Performance page: its name, value, a detail and the last minute. -->
        <Style x:Key="Orla.Metric" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Orla.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="18,14,18,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.ItemSelected}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Large choice on the welcome screen. -->
        <Style x:Key="Orla.Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource Orla.FocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1" CornerRadius="8" Padding="20,18">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.TextSecondary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="Root" Background="{DynamicResource Brush.Window}">
        <!-- Main layout -->
        <Grid x:Name="Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="244" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <DockPanel Margin="16,48,12,16">

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="FrontButton" Style="{StaticResource Orla.Button}" HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left" Padding="12,9">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Overlay}" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock x:Name="FrontLabel" Text="{l:T central.front}" />
                                <TextBlock x:Name="FrontShortcut" FontSize="11" FontWeight="Normal"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>
                    <StackPanel Orientation="Horizontal" Margin="12,14,0,0">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText" Margin="8,0,0,0" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"
                                   TextWrapping="Wrap" MaxWidth="190" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="Nav">
                    <RadioButton x:Name="NavPanels" Style="{StaticResource Orla.Nav}" Tag="{StaticResource Glyph.Grid}"
                                 Content="{l:T central.navPanels}" GroupName="nav" />
                    <RadioButton x:Name="NavPerformance" Style="{StaticResource Orla.Nav}" Tag="{StaticResource Glyph.Pulse}"
                                 Content="{l:T central.navPerformance}" GroupName="nav" />
                    <RadioButton x:Name="NavAppearance" Style="{StaticResource Orla.Nav}" Tag="{StaticResource Glyph.PanelCollection}"
                                 Content="{l:T central.navAppearance}" GroupName="nav" />
                    <RadioButton x:Name="NavGeneral" Style="{StaticResource Orla.Nav}" Tag="{StaticResource Glyph.Settings}"
                                 Content="{l:T central.navGeneral}" GroupName="nav" />
                    <RadioButton x:Name="NavAbout" Style="{StaticResource Orla.Nav}" Tag="{StaticResource Glyph.Info}"
                                 Content="{l:T central.navAbout}" GroupName="nav" />
                </StackPanel>
            </DockPanel>

            <Border Grid.Column="1" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Line}"
                    BorderThickness="1,1,0,0" CornerRadius="8,0,0,0" Margin="0,32,0,0" />
            <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,33,0,0">
                <Grid Margin="36,24,40,32" MaxWidth="760" HorizontalAlignment="Left">

                    <!-- Panels -->
                    <StackPanel x:Name="PagePanels">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="NewPanel" Style="{StaticResource Orla.Button.Accent}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Add}" Margin="0,0,8,0"
                                              Stroke="{DynamicResource Brush.OnAccent}" />
                                        <TextBlock Text="{l:T central.newPanel}" />
                                        <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ChevronDown}" Margin="6,0,-6,0"
                                              Stroke="{DynamicResource Brush.OnAccent}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T central.navPanels}" />
                        </DockPanel>
                        <TextBlock Text="{l:T central.panelsLead}" Margin="0,6,0,20" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                        <!-- Let Orla organize -->
                        <Border Style="{StaticResource Orla.Card}" Margin="0,0,0,20" Padding="18,16">
                            <StackPanel>
                                <DockPanel>
                                    <Button x:Name="OrganizeButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Accent}"
                                            VerticalAlignment="Center" Margin="24,0,0,0" Content="{l:T organize.open}" />
                                    <Image Source="{StaticResource Brand.Mark}" Width="36" Height="36" VerticalAlignment="Top" Margin="0,0,14,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Orla.CardTitle}" FontSize="{StaticResource Type.Subtitle}" FontWeight="SemiBold"
                                                   Text="{l:T organize.cardTitle}" />
                                        <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T organize.cardHint}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel x:Name="OrganizeKeepRow" Margin="50,14,0,0">
                                    <Button x:Name="OrganizeUndo" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Quiet}"
                                            Margin="16,0,0,0" VerticalAlignment="Center" Content="{l:T organize.undo}" />
                                    <CheckBox x:Name="KeepSwitch" Style="{StaticResource Orla.Switch}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T organize.keep}" />
                                            <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T organize.keepHint}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="PanelList" />
                        <StackPanel x:Name="PanelsEmpty" Visibility="Collapsed" Margin="0,28,0,8" HorizontalAlignment="Center" MaxWidth="440">
                            <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.PanelCollection}" Width="32" Height="32"
                                  Stretch="Uniform" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:T central.panelsEmpty}" Margin="0,12,0,16" TextAlignment="Center" TextWrapping="Wrap"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button x:Name="EmptyCollection" Style="{StaticResource Orla.Button.Accent}" Content="{l:T central.newCollection}"
                                        Margin="0,0,8,0" />
                                <Button x:Name="EmptyFolder" Style="{StaticResource Orla.Button}" Content="{l:T central.newFolderPanel}" />
                            </StackPanel>
                        </StackPanel>
                        <DockPanel Margin="0,12,0,0">
                            <Button x:Name="ArrangeButton" HorizontalAlignment="Left" Style="{StaticResource Orla.Button.Quiet}" VerticalAlignment="Top"
                                    Content="{l:T general.arrange}" ToolTip="{l:T general.arrangeHint}" Margin="-14,0,0,0" />
                        </DockPanel>
                        <Border Style="{StaticResource Orla.Card}" Margin="0,20,0,0" Background="Transparent">
                            <DockPanel>
                                <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Info}" Margin="0,0,12,0"
                                      VerticalAlignment="Top" />
                                <TextBlock x:Name="PanelsTip" TextWrapping="Wrap" FontSize="{StaticResource Type.Caption}"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- Performance -->
                    <StackPanel x:Name="PagePerformance" Visibility="Collapsed">
                        <DockPanel>
                            <Button x:Name="PerfPanelButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Accent}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Add}" Margin="0,0,8,0"
                                          Stroke="{DynamicResource Brush.OnAccent}" />
                                    <TextBlock x:Name="PerfPanelLabel" />
                                </StackPanel>
                            </Button>
                            <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T central.navPerformance}" />
                        </DockPanel>
                        <TextBlock Text="{l:T perf.lead}" Margin="0,6,0,20" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                        <UniformGrid x:Name="PerfMetrics" Rows="1" Margin="0,0,-8,8" />
                        <Border Style="{StaticResource Orla.Card}" Padding="18,16,18,12">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock x:Name="PerfValue" DockPanel.Dock="Right" FontFamily="{StaticResource Font.Display}" FontSize="28"
                                               FontWeight="SemiBold" VerticalAlignment="Top" Margin="16,-4,0,0" />
                                    <StackPanel>
                                        <TextBlock x:Name="PerfTitle" FontSize="{StaticResource Type.Subtitle}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="PerfHint" Style="{StaticResource Orla.CardHint}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border x:Name="PerfGpuPicker" Style="{StaticResource Orla.SegmentGroup}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                    <StackPanel x:Name="PerfGpus" Orientation="Horizontal" />
                                </Border>
                                <DockPanel Margin="0,16,0,6">
                                    <TextBlock x:Name="PerfScale" DockPanel.Dock="Right" FontSize="{StaticResource Type.Caption}"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                    <TextBlock Text="{l:T perf.lastMinute}" FontSize="{StaticResource Type.Caption}" Foreground="{DynamicResource Brush.TextSecondary}" />
                                </DockPanel>
                                <Border Height="176" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6"
                                        Background="{DynamicResource Brush.Window}" ClipToBounds="True">
                                    <l:Chart x:Name="PerfChart" Grid="True" />
                                </Border>
                                <StackPanel x:Name="PerfSummary" Orientation="Horizontal" Margin="0,8,0,18" />
                                <!-- Grows to the tallest the metric has been, so rows coming and going never move the page. -->
                                <StackPanel x:Name="PerfBody">
                                    <UniformGrid x:Name="PerfStats" Columns="4" />
                                    <StackPanel x:Name="PerfExtra" Margin="0,0,0,8" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Orla.SectionHeader}" Text="{l:T perf.topTitle}" />
                        <Border Style="{StaticResource Orla.Card}" Padding="18,10">
                            <StackPanel x:Name="PerfTop" />
                        </Border>
                        <Button x:Name="TaskManagerButton" Style="{StaticResource Orla.Button.Quiet}" HorizontalAlignment="Left" Margin="-14,8,0,0"
                                Content="{l:T perf.taskManager}" />
                    </StackPanel>

                    <!-- Appearance -->
                    <StackPanel x:Name="PageAppearance" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T central.navAppearance}" />
                        <Border x:Name="PreviewStage" Margin="0,20,0,4" CornerRadius="8" Height="220" ClipToBounds="True"
                                Background="{StaticResource Orla.Shore}">
                            <Grid x:Name="PreviewHost" Margin="28,22" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        </Border>
                        <TextBlock Text="{l:T central.previewHint}" FontSize="12" Margin="2,0,0,16"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />

                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Orla.SegmentGroup}" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ThemeSystem" Style="{StaticResource Orla.Segment}" GroupName="theme" Content="{l:T theme.system}" />
                                        <RadioButton x:Name="ThemeLight" Style="{StaticResource Orla.Segment}" GroupName="theme" Content="{l:T theme.light}" />
                                        <RadioButton x:Name="ThemeDark" Style="{StaticResource Orla.Segment}" GroupName="theme" Content="{l:T theme.dark}" />
                                    </StackPanel>
                                </Border>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T appearance.theme}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T appearance.themeHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Slider x:Name="OpacitySlider" Style="{StaticResource Orla.Slider}" Width="200" Minimum="0.75" Maximum="0.95"
                                            SmallChange="0.01" LargeChange="0.05" />
                                    <TextBlock x:Name="OpacityValue" Width="44" TextAlignment="Right" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.TextSecondary}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T appearance.opacity}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T appearance.opacityHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Style="{StaticResource Orla.SegmentGroup}" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="IconSmall" Style="{StaticResource Orla.Segment}" GroupName="icons" Content="{l:T icons.small}" />
                                        <RadioButton x:Name="IconMedium" Style="{StaticResource Orla.Segment}" GroupName="icons" Content="{l:T icons.medium}" />
                                        <RadioButton x:Name="IconLarge" Style="{StaticResource Orla.Segment}" GroupName="icons" Content="{l:T icons.large}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T appearance.iconSize}" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <CheckBox x:Name="AnimationsSwitch" Style="{StaticResource Orla.Switch}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T appearance.animations}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T appearance.animationsHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </StackPanel>

                    <!-- General -->
                    <StackPanel x:Name="PageGeneral" Visibility="Collapsed">
                        <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T central.navGeneral}" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Orla.SectionHeader}" Text="{l:T general.sectionStart}" />
                        <Border Style="{StaticResource Orla.Card}">
                            <CheckBox x:Name="StartupSwitch" Style="{StaticResource Orla.Switch}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.startup}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T general.startupHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="LanguageButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button}" VerticalAlignment="Center"
                                        Margin="24,0,0,0" MinWidth="180" HorizontalContentAlignment="Left">
                                    <DockPanel>
                                        <Path DockPanel.Dock="Right" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ChevronDown}"
                                              Margin="12,0,-4,0" />
                                        <TextBlock x:Name="LanguageLabel" />
                                    </DockPanel>
                                </Button>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.language}" />
                                    <TextBlock x:Name="LanguageHint" Style="{StaticResource Orla.CardHint}" Text="{l:T general.languageHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Orla.SectionHeader}" Text="{l:T general.sectionDesktop}" />
                        <Border Style="{StaticResource Orla.Card}">
                            <CheckBox x:Name="CleanSwitch" Style="{StaticResource Orla.Switch}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.clean}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T general.cleanHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <CheckBox x:Name="LockSwitch" Style="{StaticResource Orla.Switch}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.lock}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T general.lockHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <!-- The shortcut: on or off, and its keys right below when it is on. -->
                        <Border Style="{StaticResource Orla.Card}">
                            <StackPanel>
                                <CheckBox x:Name="HotkeySwitch" Style="{StaticResource Orla.Switch}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.hotkey}" />
                                        <TextBlock x:Name="HotkeyHint" Style="{StaticResource Orla.CardHint}" />
                                    </StackPanel>
                                </CheckBox>
                                <DockPanel x:Name="ShortcutRow" Margin="0,14,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                        <Button x:Name="ShortcutReset" Style="{StaticResource Orla.Button.Quiet}" Content="{l:T general.shortcutReset}"
                                                Margin="0,0,8,0" />
                                        <Button x:Name="ShortcutButton" Style="{StaticResource Orla.Button}" MinWidth="170" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.shortcut}" />
                                        <TextBlock x:Name="ShortcutHint" Style="{StaticResource Orla.CardHint}" Text="{l:T general.shortcutHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource Orla.SectionHeader}" Text="{l:T general.sectionAdvanced}" />
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="ResetButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button}" VerticalAlignment="Center"
                                        Margin="24,0,0,0" Content="{l:T general.resetAction}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.reset}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T general.resetHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- About -->
                    <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Image Source="{StaticResource Brand.Mark}" Width="64" Height="64" />
                            <StackPanel Margin="18,4,0,0" VerticalAlignment="Center">
                                <Viewbox Height="30" HorizontalAlignment="Left" Stretch="Uniform">
                                    <Canvas Width="149" Height="48">
                                        <Path Data="{StaticResource Brand.Word}" Fill="{DynamicResource Brush.Text}" Canvas.Left="-60" />
                                        <Path Data="{StaticResource Brand.Tagline}" Fill="{DynamicResource Brush.Accent}" Canvas.Left="-60" />
                                    </Canvas>
                                </Viewbox>
                                <TextBlock x:Name="VersionText" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Text="{l:T about.lead}" Margin="0,22,0,20" FontSize="15" TextWrapping="Wrap" MaxWidth="560"
                                   HorizontalAlignment="Left" />
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="TourButton" DockPanel.Dock="Right" Margin="24,0,0,0" Style="{StaticResource Orla.Button}"
                                        VerticalAlignment="Center" Content="{l:T about.tourAction}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T about.tour}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T about.tourHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <CheckBox x:Name="UpdateSwitch" Style="{StaticResource Orla.Switch}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T general.updates}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T general.updatesHint}" />
                                </StackPanel>
                            </CheckBox>
                        </Border>
                        <!-- Updates: where they stand, and a way to look now or install what is ready. -->
                        <Border x:Name="UpdateCard" Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button}"
                                        VerticalAlignment="Center" Margin="24,0,0,0" />
                                <StackPanel>
                                    <TextBlock x:Name="UpdateTitle" Style="{StaticResource Orla.CardTitle}" />
                                    <TextBlock x:Name="UpdateHint" Style="{StaticResource Orla.CardHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="DataButton" DockPanel.Dock="Right" Margin="24,0,0,0" Style="{StaticResource Orla.Button}" VerticalAlignment="Center"
                                        Content="{l:T about.dataAction}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T about.data}" />
                                    <TextBlock x:Name="DataPath" Style="{StaticResource Orla.CardHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                                    <Button x:Name="GuideButton" Style="{StaticResource Orla.Button}" Content="{l:T about.guide}" Margin="0,0,8,0" />
                                    <Button x:Name="IssueButton" Style="{StaticResource Orla.Button}" Content="{l:T about.issue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T about.help}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T about.license}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Style="{StaticResource Orla.Card}">
                            <DockPanel>
                                <Button x:Name="QuitButton" DockPanel.Dock="Right" Margin="24,0,0,0" Style="{StaticResource Orla.Button}" VerticalAlignment="Center"
                                        Content="{l:T about.quitAction}" />
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T about.quit}" />
                                    <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T about.quitHint}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- Welcome, second step: first panels -->
        <Grid x:Name="WelcomePresets" Visibility="Collapsed" Background="{DynamicResource Brush.Window}">
            <!-- Cards scroll; the buttons stay in view. -->
            <Grid MaxWidth="760" Margin="40,48,40,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <StackPanel VerticalAlignment="Top" Margin="0,0,8,0">
                        <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T welcome.presetsTitle}" Margin="0,0,0,6" />
                        <TextBlock Text="{l:T welcome.presetsLead}" Foreground="{DynamicResource Brush.TextSecondary}"
                                   FontSize="{StaticResource Type.Lead}" TextWrapping="Wrap" />
                        <UniformGrid x:Name="PresetChoices" Columns="3" Margin="0,24,-8,0" />
                        <TextBlock x:Name="PresetsLoading" Text="{l:T welcome.presetsLoading}" Margin="0,24,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </ScrollViewer>
                <DockPanel Grid.Row="1" Margin="0,16,0,0">
                    <Button x:Name="FinishButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Accent}"
                            Content="{l:T welcome.createPanels}" Padding="22,9" />
                    <Button x:Name="BackButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Quiet}" Content="{l:T welcome.back}"
                            Margin="0,0,8,0" />
                    <TextBlock />
                </DockPanel>
            </Grid>
        </Grid>

        <!-- Welcome -->
        <Grid x:Name="Welcome" Visibility="Collapsed" Background="{DynamicResource Brush.Window}">
            <StackPanel MaxWidth="720" VerticalAlignment="Center" Margin="40">
                <Image Source="{StaticResource Brand.Mark}" Width="56" Height="56" HorizontalAlignment="Left" />
                <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T welcome.title}" Margin="0,22,0,6" />
                <TextBlock Text="{l:T welcome.lead}" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{StaticResource Type.Lead}" TextWrapping="Wrap" />
                <UniformGrid Columns="2" Margin="0,28,0,0">
                    <RadioButton x:Name="ChoiceOrganize" Style="{StaticResource Orla.Choice}" GroupName="start" Margin="0,0,8,0" IsChecked="True">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" Background="{DynamicResource Brush.Accent}" CornerRadius="10" Padding="9,2"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{l:T organize.recommended}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.OnAccent}" />
                                </Border>
                                <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.PanelCollection}" HorizontalAlignment="Left"
                                      Stroke="{DynamicResource Brush.Accent}" />
                            </DockPanel>
                            <TextBlock Text="{l:T welcome.organize}" FontSize="{StaticResource Type.Subtitle}" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <TextBlock Text="{l:T welcome.organizeHint}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChoiceAlongside" Style="{StaticResource Orla.Choice}" GroupName="start" Margin="8,0,0,0">
                        <StackPanel>
                            <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Desktop}" HorizontalAlignment="Left"
                                  Stroke="{DynamicResource Brush.Accent}" />
                            <TextBlock Text="{l:T welcome.alongside}" FontSize="{StaticResource Type.Subtitle}" FontWeight="SemiBold" Margin="0,14,0,6" />
                            <TextBlock Text="{l:T welcome.alongsideHint}" TextWrapping="Wrap" FontSize="13"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
                <DockPanel Margin="0,28,0,0">
                    <Button x:Name="StartButton" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Accent}" Content="{l:T welcome.start}"
                            Padding="22,9" />
                    <TextBlock x:Name="WelcomeTip" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </DockPanel>
            </StackPanel>
        </Grid>

        <!-- Let Orla organize: a map of the screen with the planned panels, before anything changes -->
        <Grid x:Name="OrganizePreview" Visibility="Collapsed" Background="{DynamicResource Brush.Window}">
            <DockPanel MaxWidth="820" Margin="40,28">
                <DockPanel DockPanel.Dock="Top">
                    <!-- With panels already organized: add what is new, or start the layout again. -->
                    <Border x:Name="OrganizeModes" DockPanel.Dock="Right" Style="{StaticResource Orla.SegmentGroup}" VerticalAlignment="Top"
                            Margin="24,6,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="OrganizeComplete" Style="{StaticResource Orla.Segment}" GroupName="organizeMode"
                                         Content="{l:T organize.complete}" IsChecked="True" />
                            <RadioButton x:Name="OrganizeRedo" Style="{StaticResource Orla.Segment}" GroupName="organizeMode"
                                         Content="{l:T organize.redo}" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Orla.PageTitle}" Text="{l:T organize.title}" Margin="0,0,0,6" />
                        <TextBlock x:Name="OrganizeLead" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{StaticResource Type.Lead}" TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
                <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
                    <Button x:Name="OrganizeApply" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Accent}"
                            Content="{l:T organize.apply}" Padding="22,9" />
                    <Button x:Name="OrganizeBack" DockPanel.Dock="Right" Style="{StaticResource Orla.Button.Quiet}"
                            Content="{l:T welcome.back}" Margin="0,0,8,0" />
                    <TextBlock x:Name="OrganizeNote" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center" Margin="0,0,24,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" />
                </DockPanel>
                <UniformGrid x:Name="OrganizeOptions" DockPanel.Dock="Bottom" Rows="1" Margin="-4,16,-4,0">
                    <Border Style="{StaticResource Orla.Card}" Margin="4,0">
                        <CheckBox x:Name="OrganizeClean" Style="{StaticResource Orla.Switch}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T organize.clean}" />
                                <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T organize.cleanHint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Orla.Card}" Margin="4,0">
                        <CheckBox x:Name="OrganizeKeep" Style="{StaticResource Orla.Switch}" IsChecked="True">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T organize.keep}" />
                                <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T organize.keepHint}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </UniformGrid>
                <!-- The screens the plan uses, in miniature and where they really are, centred in a card that takes the room left. -->
                <Border x:Name="OrganizeStage" Style="{StaticResource Orla.Card}" Margin="0,20,0,0" Padding="12">
                    <DockPanel>
                        <!-- Only with more than one monitor; it belongs with the map it changes. -->
                        <CheckBox x:Name="OrganizeSecond" DockPanel.Dock="Top" Style="{StaticResource Orla.Switch}" IsChecked="True"
                                  Margin="6,0,6,12" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Orla.CardTitle}" Text="{l:T organize.second}" />
                                <TextBlock Style="{StaticResource Orla.CardHint}" Text="{l:T organize.secondHint}" />
                            </StackPanel>
                        </CheckBox>
                        <Canvas x:Name="OrganizeMap" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" />
                    </DockPanel>
                </Border>
            </DockPanel>
        </Grid>

        <!-- The title strip: Orla's mark and name, like Windows 11 apps. -->
        <StackPanel x:Name="CaptionTitle" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16,8,0,0"
                    IsHitTestVisible="False">
            <Image Source="{StaticResource Brand.Mark}" Width="16" Height="16" />
            <TextBlock Text="Orla Desktop" FontSize="{StaticResource Type.Caption}" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource Brush.TextSecondary}" />
        </StackPanel>

        <!-- Caption buttons, above every page and overlay. -->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal" Panel.ZIndex="100">
            <Button x:Name="MinimizeButton" Style="{StaticResource Orla.Caption}" Content="{StaticResource Caption.Minimize}"
                    ToolTip="{l:T window.minimize}" AutomationProperties.Name="{l:T window.minimize}" />
            <Button x:Name="MaximizeButton" Style="{StaticResource Orla.Caption}" Content="{StaticResource Caption.Maximize}"
                    ToolTip="{l:T window.maximize}" AutomationProperties.Name="{l:T window.maximize}" />
            <Button x:Name="CloseButton" Style="{StaticResource Orla.Caption.Close}" Content="{StaticResource Caption.Close}"
                    ToolTip="{l:T window.close}" AutomationProperties.Name="{l:T window.close}" />
        </StackPanel>
    </Grid>
</Window>
