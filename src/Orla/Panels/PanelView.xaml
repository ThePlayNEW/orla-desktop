<UserControl x:Class="Orla.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orla"
             FontFamily="{StaticResource Font.Text}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Focusable="False">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:TileItem}">
            <Border x:Name="Tile" Width="{DynamicResource Tile.Body}" Height="{DynamicResource Tile.Body}" Margin="1" Padding="4,8,4,4"
                    CornerRadius="{StaticResource Radius.Item}" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent" Focusable="True" FocusVisualStyle="{x:Null}" ToolTip="{Binding Tooltip}"
                    AutomationProperties.Name="{Binding Label}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Width="{DynamicResource Tile.Icon}" Height="{DynamicResource Tile.Icon}">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Path x:Name="Missing" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ItemMissing}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock Text="{Binding Label}" Margin="0,6,0,0" FontSize="{StaticResource Type.ItemLabel}"
                               Foreground="{DynamicResource Brush.Text}" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" Height="32" LineHeight="16"
                               LineStackingStrategy="BlockLineHeight" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.ItemHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.ItemSelected}" />
                </DataTrigger>
                <!-- The focus ring shows only while the keyboard is in use, as in Explorer. -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsKeyboardFocused, ElementName=Tile}" Value="True" />
                        <Condition Binding="{Binding KeyboardCues, RelativeSource={RelativeSource AncestorType=local:PanelView}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Missing" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Resize zones along every edge and corner. A thin accent line shows which edge is under the pointer. -->
        <Style x:Key="Edge" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Background="Transparent">
                            <Border x:Name="Line" Background="{DynamicResource Brush.Focus}" CornerRadius="1" Opacity="0"
                                    HorizontalAlignment="{TemplateBinding HorizontalAlignment}" VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                    MinWidth="2" MinHeight="2" Margin="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="0.7" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Line" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Brush.PanelGlass}"
                BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" Padding="8,6,8,10" AllowDrop="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="34" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid x:Name="Header" Background="Transparent" Cursor="SizeAll">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- A dock, not a stack, so a long title gives way with an ellipsis and the count stays in view. -->
                    <DockPanel VerticalAlignment="Center" Margin="6,0,4,0" HorizontalAlignment="Left" LastChildFill="True">
                        <!-- Inside a subfolder of a folder panel: back to the folder above. -->
                        <Button x:Name="BackButton" DockPanel.Dock="Left" Style="{StaticResource Orla.IconButton}" Cursor="Hand"
                                Margin="-6,0,2,0" Visibility="Collapsed">
                            <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ChevronLeft}" />
                        </Button>
                        <Path x:Name="KindGlyph" DockPanel.Dock="Left" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.PanelFolder}"
                              Margin="-2,0,6,0" Visibility="Collapsed" />
                        <TextBox x:Name="TitleEditor" DockPanel.Dock="Left" Style="{StaticResource Orla.TextBox}" FontSize="{StaticResource Type.PanelTitle}"
                                 Padding="4,2" MinWidth="120" MaxLength="60" Visibility="Collapsed" Cursor="IBeam" />
                        <TextBlock x:Name="Count" DockPanel.Dock="Right" FontSize="{StaticResource Type.PanelTitle}" Margin="8,0,0,0"
                                   Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Title" FontSize="{StaticResource Type.PanelTitle}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.55">
                        <Button x:Name="CollapseButton" Style="{StaticResource Orla.IconButton}" Cursor="Hand">
                            <Path x:Name="CollapseGlyph" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ChevronUp}" />
                        </Button>
                        <Button x:Name="MenuButton" Style="{StaticResource Orla.IconButton}" Cursor="Hand">
                            <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.More}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <Path x:Name="Shoreline" Grid.Row="1" Height="6" Margin="6,0,6,4" Stretch="Fill" StrokeThickness="1.5"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                      Data="M 0 3 C 40 0 70 6 110 3 S 190 0 230 3 S 280 6 300 3" />

                <Grid x:Name="Body" Grid.Row="2" Background="Transparent">
                    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False" PanningMode="VerticalOnly">
                        <ItemsControl x:Name="Items" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock x:Name="Empty" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{StaticResource Type.Caption}"
                               TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Margin="16,0" IsHitTestVisible="False" Visibility="Collapsed" />
                    <Canvas IsHitTestVisible="False">
                        <Rectangle x:Name="Marquee" Visibility="Collapsed" RadiusX="3" RadiusY="3" StrokeThickness="1"
                                   Stroke="{DynamicResource Brush.Focus}" Fill="{DynamicResource Brush.DropTarget}" />
                        <!-- Where dragged items will land in a collection. -->
                        <Rectangle x:Name="InsertMark" Visibility="Collapsed" Width="3" RadiusX="1.5" RadiusY="1.5"
                                   Fill="{DynamicResource Brush.Focus}" />
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="Edges">
            <Thumb Tag="Left" Style="{StaticResource Edge}" Width="8" HorizontalAlignment="Left" Margin="0,16" Cursor="SizeWE" />
            <Thumb Tag="Right" Style="{StaticResource Edge}" Width="8" HorizontalAlignment="Right" Margin="0,16" Cursor="SizeWE" />
            <Thumb Tag="Top" Style="{StaticResource Edge}" Height="6" VerticalAlignment="Top" Margin="16,0" Cursor="SizeNS" />
            <Thumb Tag="Bottom" Style="{StaticResource Edge}" Height="8" VerticalAlignment="Bottom" Margin="16,0" Cursor="SizeNS" />
            <Thumb Tag="TopLeft" Style="{StaticResource Edge}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="SizeNWSE" />
            <Thumb Tag="TopRight" Style="{StaticResource Edge}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="SizeNESW" />
            <Thumb Tag="BottomLeft" Style="{StaticResource Edge}" Width="16" Height="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="SizeNESW" />
            <Thumb Tag="BottomRight" Style="{StaticResource Edge}" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" />
        </Grid>

        <!-- Size while resizing, in columns × rows. -->
        <Border x:Name="SizeHint" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12,5" CornerRadius="12"
                Background="{DynamicResource Brush.Accent}" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="{DynamicResource Brush.OnAccent}" FontSize="13" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
