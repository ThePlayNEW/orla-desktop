<UserControl x:Class="Orla.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Orla"
             FontFamily="{StaticResource Font.Text}"
             UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display"
             Focusable="False">

    <UserControl.Resources>
        <DataTemplate DataType="{x:Type local:TileItem}">
            <Border x:Name="Tile" Width="{DynamicResource Tile.Width}" Margin="1" Padding="4,8,4,6"
                    CornerRadius="{StaticResource Radius.Item}" Background="Transparent" BorderThickness="1"
                    BorderBrush="Transparent" Focusable="True" FocusVisualStyle="{x:Null}" ToolTip="{Binding Tooltip}"
                    AutomationProperties.Name="{Binding Label}">
                <StackPanel>
                    <Grid Width="{DynamicResource Tile.Icon}" Height="{DynamicResource Tile.Icon}">
                        <Image Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                        <Path x:Name="Missing" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ItemMissing}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                    </Grid>
                    <TextBlock Text="{Binding Label}" Margin="0,6,0,0" FontSize="{StaticResource Type.ItemLabel}"
                               Foreground="{DynamicResource Brush.Text}" TextAlignment="Center" TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis" MaxHeight="32" LineHeight="16"
                               LineStackingStrategy="BlockLineHeight" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.ItemHover}" />
                </Trigger>
                <DataTrigger Binding="{Binding Selected}" Value="True">
                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource Brush.ItemSelected}" />
                </DataTrigger>
                <Trigger SourceName="Tile" Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                    <Setter TargetName="Tile" Property="Opacity" Value="0.55" />
                    <Setter TargetName="Missing" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border x:Name="Frame" CornerRadius="{StaticResource Radius.Panel}" Background="{DynamicResource Brush.PanelGlass}"
            BorderBrush="{DynamicResource Brush.PanelBorder}" BorderThickness="1" Padding="{StaticResource Space.Panel}"
            AllowDrop="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Height="34" Background="Transparent" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,4,0">
                    <Path x:Name="KindGlyph" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.PanelFolder}"
                          Margin="-2,0,6,0" Visibility="Collapsed" />
                    <TextBlock x:Name="Title" FontSize="{StaticResource Type.PanelTitle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <TextBox x:Name="TitleEditor" Style="{StaticResource Orla.TextBox}" FontSize="{StaticResource Type.PanelTitle}"
                             Padding="4,2" MinWidth="120" MaxLength="60" Visibility="Collapsed" Cursor="IBeam" />
                    <TextBlock x:Name="Count" FontSize="{StaticResource Type.PanelTitle}" Margin="8,0,0,0"
                               Foreground="{DynamicResource Brush.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel x:Name="HeaderButtons" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Opacity="0.55">
                    <Button x:Name="CollapseButton" Style="{StaticResource Orla.IconButton}" Cursor="Hand">
                        <Path x:Name="CollapseGlyph" Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.ChevronUp}" />
                    </Button>
                    <Button x:Name="MenuButton" Style="{StaticResource Orla.IconButton}" Cursor="Hand">
                        <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.More}" />
                    </Button>
                </StackPanel>
            </Grid>

            <Path x:Name="Shoreline" Grid.Row="1" Height="6" Margin="6,0,6,4" Stretch="Fill" StrokeThickness="1.5"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"
                  Data="M 0 3 C 40 0 70 6 110 3 S 190 0 230 3 S 280 6 300 3" />

            <Grid x:Name="Body" Grid.Row="2">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" PanningMode="VerticalOnly">
                    <ItemsControl x:Name="Items" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock x:Name="Empty" Foreground="{DynamicResource Brush.TextSecondary}" FontSize="{StaticResource Type.Caption}"
                           TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Margin="24,0" MaxWidth="240" IsHitTestVisible="False" Visibility="Collapsed" />
                <Thumb x:Name="Grip" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-4,-6"
                       Cursor="SizeNWSE" Opacity="0.6">
                    <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                            <Grid Background="Transparent">
                                <Path Style="{StaticResource Orla.Glyph}" Data="{StaticResource Glyph.Resize}" Width="16" Height="16"
                                      Margin="-2,-2,0,0">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Path.RenderTransform>
                                </Path>
                            </Grid>
                        </ControlTemplate>
                    </Thumb.Template>
                </Thumb>
            </Grid>
        </Grid>
    </Border>
</UserControl>
