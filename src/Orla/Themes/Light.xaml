<!-- Linha d'água, light theme. Panel glass alpha is replaced at runtime by the opacity setting (75–95%, default 82%), which keeps text at 6:1 or better over any wallpaper. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="Color.PanelGlass">#D1F2F6F5</Color>
    <SolidColorBrush x:Key="Brush.PanelGlass" Color="{StaticResource Color.PanelGlass}" />
    <SolidColorBrush x:Key="Brush.PanelBorder" Color="#240E3B43" />
    <SolidColorBrush x:Key="Brush.Shoreline" Color="#2F9E96" />

    <SolidColorBrush x:Key="Brush.Text" Color="#0E3B43" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4A6A6E" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#8FA5A7" />
    <SolidColorBrush x:Key="Brush.Glyph" Color="#17605B" />

    <SolidColorBrush x:Key="Brush.ItemHover" Color="#140E3B43" />
    <SolidColorBrush x:Key="Brush.ItemPressed" Color="#240E3B43" />
    <SolidColorBrush x:Key="Brush.ItemSelected" Color="#2E1D7F79" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#1D7F79" />
    <SolidColorBrush x:Key="Brush.DropTarget" Color="#141D7F79" />

    <SolidColorBrush x:Key="Brush.Accent" Color="#1D7F79" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#176A65" />

    <SolidColorBrush x:Key="Brush.Window" Color="#F7FAF9" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Control" Color="#E9F0EF" />
    <SolidColorBrush x:Key="Brush.ControlHover" Color="#DDE8E6" />
    <SolidColorBrush x:Key="Brush.Line" Color="#D6E2E0" />

    <SolidColorBrush x:Key="Brush.Warning" Color="#8A5A00" />
    <SolidColorBrush x:Key="Brush.Critical" Color="#B3261E" />
    <SolidColorBrush x:Key="Brush.OnCritical" Color="#FFFFFF" />

    <!-- Shoreline tints a panel can choose. -->
    <SolidColorBrush x:Key="Brush.Tint.seaglass" Color="#2F9E96" />
    <SolidColorBrush x:Key="Brush.Tint.sand" Color="#B5892F" />
    <SolidColorBrush x:Key="Brush.Tint.coral" Color="#D0604F" />
    <SolidColorBrush x:Key="Brush.Tint.sky" Color="#3F7FD0" />
    <SolidColorBrush x:Key="Brush.Tint.moss" Color="#5E8C3A" />

</ResourceDictionary>
