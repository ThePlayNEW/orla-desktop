root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = block_scoped
dotnet_naming_rule.methods_use_camel_case.severity = warning
dotnet_naming_rule.methods_use_camel_case.symbols = methods
dotnet_naming_rule.methods_use_camel_case.style = camel_case
dotnet_naming_symbols.methods.applicable_kinds = method
dotnet_naming_style.camel_case.capitalization = camel_case
